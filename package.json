{
    "name": "neutda-ai",
    "version": "1.0.0",
    "description": "Express API that proxies chat requests to a local llama.cpp server running the Qwen vision model.",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "start": "node -e \"console.error('\\n  \\u274c \\uBAA8\\uB378 \\uC11C\\uBC84\\uAC00 \\uD568\\uAED8 \\uAE30\\uB3D9\\uB418\\uC9C0 \\uC54A\\uC2B5\\uB2C8\\uB2E4.\\n     \\uC804\\uCCB4 \\uAE30\\uB3D9\\uC740  npm run up  \\uC744 \\uC0AC\\uC6A9\\uD558\\uC138\\uC694 (Express\\uB9CC \\uD544\\uC694\\uD558\\uBA74  npm run serve ).\\n'); process.exit(1)\"",
        "serve": "node src/server.js",
        "agent": "node src/agent.js",
        "solo": "node src/solo.js",
        "stop": "node scripts/os-run.js stop",
        "dev": "node --watch src/server.js",
        "up": "node scripts/os-run.js up",
        "down": "node scripts/os-run.js down",
        "restart": "node scripts/os-run.js restart",
        "llama": "node scripts/os-run.js llama",
        "cluster": "node scripts/os-run.js cluster",
        "ctl": "node scripts/ctl.mjs"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "adm-zip": "^0.5.17",
        "cfb": "^1.2.2",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "mammoth": "^1.12.0",
        "marked": "^18.0.5",
        "multer": "^2.2.0",
        "pdf-parse": "^2.4.5",
        "pg": "^8.23.0"
    }
}
