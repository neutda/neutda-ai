# ===== Express =====
PORT=3000

# ===== 호스트 OS (serve / agent 공용) =====
# LINUX | WINDOW | auto
# - WINDOW: netstat/taskkill, llama-server.exe
# - LINUX: ss/lsof, SIGTERM, llama-server
# - auto(기본): process.platform 으로 결정
# OS=auto
# OS=WINDOW
# OS=LINUX

# ===== LLM 백엔드 =====
# 우선순위: agent 등록(servers.json) > LLAMA_BACKENDS > LLAMA_SERVERS / LLAMA_SERVER_URL
# `npm run serve` 부모는 자기 servers.json 을 풀에 싣지 않음.
# 모델은 `npm run agent` / `npm run solo` 등록으로 풀에 올라감.
# servers.json 없을 때만 아래 폴백 사용.
# LLAMA_BACKENDS=large@http://127.0.0.1:8080@gpu,medium@http://127.0.0.1:8090@gpu
# LLAMA_SERVERS=http://127.0.0.1:8080
# LLAMA_SERVER_URL=http://127.0.0.1:8080

# ===== 라우팅 =====
API_KEY=tw-demo-key-2026
# ROUTING_MODE: heuristic(글자수) | llm(라우터 역할 켠 모델) | hybrid
ROUTING_MODE=llm
# ROUTER_BACKEND_URL=http://127.0.0.1:8090
ROUTER_TEMPERATURE=0.1
ROUTER_MAX_TOKENS=128
DEFAULT_TIER=small
SMALL_MAX_CHARS=200
LARGE_MIN_CHARS=600
GPU_MIN_DIFFICULTY=50
ESCALATE_TIER=true
# WORKFLOW_MODE: auto | on | off  (콘솔 "파이프라인 강제사용" 시 body 로 덮어씀)
WORKFLOW_MODE=auto

# ===== 모델 / 어시스턴트 =====
MODEL_NAME=qwen
# ASSISTANT_NAME=neutda-ai (뉴트다)
# ASSISTANT_IDENTITY=You are neutda-ai (뉴트다), a local multi-model AI assistant. ...

# ===== 생성 파라미터 =====
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
MAX_TOKENS_SMALL=1024
MAX_PROMPT_CHARS_SMALL=1800
MAX_PROMPT_CHARS_LARGE=3500
ENABLE_THINKING=false

# 언어 드리프트 방지 (한국어 질문 → 한국어 답변 강제 등)
ENFORCE_LANGUAGE=true
# REPLY_LANGUAGE_DIRECTIVE=Reply in the same language as the user's question. ...

# ===== 타임아웃 / 풀 =====
REQUEST_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=120000
HEALTH_INTERVAL_MS=5000
MAX_RETRIES=2

# ===== llama 동시 처리 (serve / agent 공용) =====
# .env 한 줄로 llama-server --parallel 과 Express 채팅 동시투입 한도를 맞춤.
# - agent/solo 기동 시: --parallel N , 총 -c = ctx×N (KV VRAM ≈ N배)
# - Express CHAT_MAX_INFLIGHT=0(자동) → solve 수 × N 까지 바로 전송
# 서버별 개별값: servers.json / 서버·모델관리 UI 의 "parallel" (있으면 .env 보다 우선)
# large 권장 2 · medium 4~8. 변경 후 llama 재기동 필요
LLAMA_PARALLEL=4

# ===== 실행 모드 (serve / agent / solo) =====
# 단일:  npm run solo
# 분산:  npm run serve  +  각 머신 npm run agent
#
# [부모] 하위 관리서버 폴링
AGENT_POLL_INTERVAL_MS=5000
AGENT_DOWN_AFTER_MISSES=3
AGENT_REQUEST_TIMEOUT_MS=4000
#
# [하위 관리서버] npm run agent
PARENT_URL=http://127.0.0.1:3000
# AGENT_ID=                        # 미지정 시 hostname
AGENT_PORT=4100
# AGENT_HOST=                      # 미지정: 부모 localhost→127.0.0.1 / 원격→LAN 자동
AGENT_HEARTBEAT_MS=5000
AGENT_AUTOSTART=false
# llama bind. 한 머신 serve+agent 는 127.0.0.1 유지. 분산 시 0.0.0.0 (또는 AGENT_HOST=LAN 이면 자동 전환)
LLAMA_BIND_HOST=127.0.0.1
# SOLO=1                           # npm run solo 가 자동 설정. 수동 지정 불필요

# ===== 긴 입력 맵리듀스 =====
LONG_TRIGGER_CHARS=3200
LONG_TRIGGER_TOKENS=3000
LONG_CHUNK_CHARS=1800
LONG_CHUNK_OVERLAP=180
LONG_REDUCE_INPUT_CHARS=4500
LONG_MAP_TIER=medium
LONG_REDUCE_TIER=large
LONG_MAP_CONCURRENCY=4

# ===== 채팅 요청 큐 (solve 슬롯 가득일 때만 대기) =====
# 미지정·0 = 자동 (건강한 solve 수 × LLAMA_PARALLEL) — 슬롯 있으면 바로 전송
# 양의 정수 = 인위적 상한 (예: 부하 테스트용으로 2)
# CHAT_MAX_INFLIGHT=0
# CHAT_QUEUE_MAX=10
# CHAT_QUEUE_WAIT_MS=120000

# ===== 슬롯 인지 라우팅 (large 포화 시 중간 난이도 → medium 강등) =====
# LOAD_AWARE=on
# LOAD_DEMOTE_MAX_DIFFICULTY=75

# ===== 앱 로그 (일별 JSONL) =====
# LOG_DIR=./logs
# LOG_RETENTION_DAYS=14

# ===== 개인 기억 (U_ID 장기 / S_ID 단기) =====
# MEMORY_MAX_ENTRIES=200
# MEMORY_MIN_SCORE_EMBED=0.32
# MEMORY_MIN_SCORE_BM25=0.5
# data/logs/all-<scope>-YYYY-MM-DD.jsonl , error-<scope>-YYYY-MM-DD.jsonl
# APP_LOG_DIR=                      # 기본: <repo>/data/logs
# APP_LOG_SCOPE=express             # agent 는 자동으로 agent-<id>
